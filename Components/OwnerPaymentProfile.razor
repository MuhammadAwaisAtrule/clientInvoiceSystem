@page "/owner-payment-profile"
@rendermode InteractiveServer
@using Client_Invoice_System.Models
@using Client_Invoice_System.Repositories
@inject OwnerPaymentProfileRepository OwnerPaymentProfileRepository

<h3>Owner Payment Profile</h3>

@if (paymentProfile != null)
{
    <EditForm Model="paymentProfile" OnValidSubmit="SavePaymentProfile">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card p-4">
            <div class="mb-3">
                <label class="form-label">IBAN Number</label>
                <InputText class="form-control" @bind-Value="paymentProfile.IBANNumber" />
                <ValidationMessage For="() => paymentProfile.IBANNumber" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Currency</label>
                <InputText class="form-control" @bind-Value="paymentProfile.Currency" />
                <ValidationMessage For="() => paymentProfile.Currency" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Account Title</label>
                <InputText class="form-control" @bind-Value="paymentProfile.AccountTitle" />
                <ValidationMessage For="() => paymentProfile.AccountTitle" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Account Number</label>
                <InputText class="form-control" @bind-Value="paymentProfile.AccountNumber" />
                <ValidationMessage For="() => paymentProfile.AccountNumber" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </EditForm>
}
else
{
    <p>Loading...</p>
}

@code {
    private PaymentProfile paymentProfile = new();

    protected override async Task OnInitializedAsync()
    {
        paymentProfile = await OwnerPaymentProfileRepository.GetOwnerPaymentProfileAsync();
    }

    private async Task SavePaymentProfile()
    {
        await OwnerPaymentProfileRepository.UpdateOwnerPaymentProfileAsync(paymentProfile);
    }
}
